{
  // Cloudflare Workers (plan gratuito): API + sitio estático en un solo deploy.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "findmytrip",
  "main": "server/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Caché de búsquedas (gratis). Wrangler crea el KV solo en el primer deploy.
  "kv_namespaces": [{ "binding": "CACHE" }],
  // Workers AI: el agente funciona gratis (cuota diaria) si no hay clave de Claude.
  "ai": { "binding": "AI" },
  // Tu ID de afiliado de Travelpayouts (no es secreto: viaja en los links).
  "vars": {
    "TRAVELPAYOUTS_MARKER": "789588",
    // ID del proyecto en Travelpayouts: links con comisión para traslados, excursiones, eSIM y seguro.
    "TRAVELPAYOUTS_TRS": "585192",
    "SITE_URL": "https://findmytrip.deorejasyvaritas.workers.dev",
    "RADAR_ORIGINS": "BUE"
  },
  // Radar automático: 5 barridos por día (horas UTC; 22, 3, 8, 13 y 18 h en Argentina).
  "triggers": { "crons": ["17 1,6,11,16,21 * * *"] },
  "observability": { "enabled": true }
}
