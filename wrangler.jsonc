{
  // Cloudflare Workers (plan gratuito): API + sitio estático en un solo deploy.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "findmytrip",
  "main": "server/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Caché de búsquedas (gratis). Wrangler crea el KV solo en el primer deploy.
  "kv_namespaces": [{ "binding": "CACHE" }],
  // Workers AI: el agente funciona gratis (cuota diaria) si no hay clave de Claude.
  "ai": { "binding": "AI" },
  // Tu ID de afiliado de Travelpayouts (no es secreto: viaja en los links).
  "vars": { "TRAVELPAYOUTS_MARKER": "789588" },
  "observability": { "enabled": true }
}
