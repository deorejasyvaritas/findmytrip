# Puerto del servidor API
PORT=8787

# Opcional: habilita el agente conversacional (Claude).
# Sin esta clave la app funciona igual, pero sin el chat del agente.
ANTHROPIC_API_KEY=

# Opcional: precios de vuelos en vivo (Travelpayouts / Aviasales Data API).
# Registrate gratis en https://www.travelpayouts.com/ y copiá tu token.
# Sin token se usan estimaciones basadas en temporada y distancia.
TRAVELPAYOUTS_TOKEN=

# Cotización usada para mostrar precios en pesos (ARS por USD).
USD_ARS_RATE=1450
